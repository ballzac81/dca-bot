# ============================================================
# DCA Bot — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# -- Webhook security ---------------------------------------------------------
# Random string — used to authenticate TradingView webhooks
# Generate with: openssl rand -hex 24
SECRET_TOKEN=CHANGE_THIS
# Buys through Cloudflare must come from TradingView's webhook IPs.
# Local curl on the server is still allowed. Set false only for debugging.
ENFORCE_WEBHOOK_IPS=true
# Ignore a second buy for the same pair within this many seconds.
BUY_COOLDOWN_SECONDS=240

# -- Freqtrade ----------------------------------------------------------------
FREQTRADE_USER=admin
FREQTRADE_PASS=CHANGE_THIS

# -- Trading ------------------------------------------------------------------
TRADING_PAIR=BTC/AUD
BASE_STAKE=150          # per buy signal, before the chart multiplier
BASE_STAKE_CURRENCY=AUD # AUD is converted to USD at the live Kraken AUD/USD rate. The order is still placed in USD.
MIN_STAKE=15            # Minimum, in BASE_STAKE_CURRENCY. Skips the buy if the sized stake is below this.
SELL_RATIO=1.0          # Not used by indicator but available for manual sells

# -- Kraken API (set in user_data/config.json — not here) --------------------
# Exchange credentials go in user_data/config.json, not in this file.

# -- Grok vision API ----------------------------------------------------------
# Get your key at: https://console.x.ai
XAI_API_KEY=CHANGE_THIS
XAI_MODEL=grok-4.7

# -- TradingView chart --------------------------------------------------------
# Per-pair chart URLs — bot picks the right chart based on the alert pair.
# TV_CHART_URL is the fallback if no per-pair URL is set.
# Example: https://www.tradingview.com/chart/AbCdEfGh/
TV_CHART_URL_BTC=CHANGE_THIS
TV_CHART_URL_SOL=CHANGE_THIS
TV_CHART_URL=CHANGE_THIS     # fallback / single-pair setups

# TradingView session cookies (exported with Cookie-Editor browser extension).
# See GET_COOKIES.md for step-by-step instructions.
# Paste the full JSON array on one line.
TV_COOKIES_JSON=[{"name":"sessionid","value":"CHANGE_THIS","domain":".tradingview.com","path":"/","httpOnly":true,"secure":true}]

# How long to wait (ms) for the chart to fully render before screenshotting.
# Increase if the indicator labels aren't showing in screenshots.
CHART_WAIT_MS=5000

# -- Telegram (optional) ------------------------------------------------------
TELEGRAM_TOKEN=CHANGE_THIS
TELEGRAM_CHAT_ID=CHANGE_THIS
