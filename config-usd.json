{
    "max_open_trades": 10,
    "stake_currency": "USD",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "dry_run": true,
    "dry_run_wallet": 10000,
    "cancel_open_orders_on_exit": false,

    "exchange": {
        "name": "kraken",
        "key": "CHANGE_THIS_TO_YOUR_API_KEY",
        "secret": "CHANGE_THIS_TO_YOUR_API_SECRET",
        "ccxt_config": {},
        "ccxt_async_config": {}
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "pairlists": [
        {"method": "StaticPairList"}
    ],

    "pair_whitelist": [
        "JUP/USD"
    ],

    "telegram": {
        "enabled": false,
        "token": "",
        "chat_id": ""
    },

    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "CHANGE_THIS_TO_A_DIFFERENT_RANDOM_32_CHAR_STRING",
        "CORS_origins": [],
        "username": "admin",
        "password": "CHANGE_THIS_TO_YOUR_FREQTRADE_PASSWORD"
    },

    "bot_name": "IADSS-DCA-Bot-USD",
    "initial_state": "running",
    "force_entry_enable": true,
    "internals": {
        "process_throttle_secs": 5
    }
}
